# Render/Netlify BYOK deployment: no provider keys or other secrets are required.
# Learners enter their own provider keys in the app's Settings.
# Never prefix secrets with VITE_: Vite exposes those values to the browser.

# Render sets TEMARI_HOSTED=true; RENDER=true also enforces hosted mode.
# Set this locally to exercise BYOK-only behaviour (default local mode is unrestricted).
# TEMARI_HOSTED=true

# Optional self-hosted Node server settings (not used by the Netlify function):
PORT=3000
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
